APP_NAME=WeatherEdgeflow
APP_ENV=local
APP_HOST=127.0.0.1
APP_PORT=8000
DATABASE_URL=sqlite:///./data/weatheredgeflow.sqlite3
LOG_LEVEL=INFO
LOG_FILE=./logs/weatheredgeflow.log

# Public APIs only. No private keys are required or accepted.
POLYMARKET_GAMMA_BASE_URL=https://gamma-api.polymarket.com
POLYMARKET_CLOB_BASE_URL=https://clob.polymarket.com
POLYMARKET_DATA_BASE_URL=https://data-api.polymarket.com
KALSHI_BASE_URL=https://external-api.kalshi.com/trade-api/v2
KALSHI_SERIES_TICKERS=KXHIGHNY,KXHIGHCHI,KXHIGHMIA,KXHIGHLAX,KXHIGHDEN
KALSHI_WEATHER_SOURCE_BASE_URL=https://weather.com/kalshi
KALSHI_REQUIRE_OFFICIAL_WEATHER_SOURCE=true
KALSHI_MIN_SOURCE_MARGIN_F=2.0
BINANCE_SPOT_BASE_URL=https://api.binance.com
BINANCE_FUTURES_BASE_URL=https://fapi.binance.com
CRYPTO_SYMBOLS=BTCUSDT,ETHUSDT,SOLUSDT
CRYPTO_MIN_NET_DAILY_EDGE=0.001
CRYPTO_MAX_SPREAD=0.001
CRYPTO_MAX_BASIS_RISK=0.005
CRYPTO_MIN_NOTIONAL_USD=25.0
CRYPTO_SPOT_FEE_RATE=0.001
CRYPTO_FUTURES_FEE_RATE=0.0005
CRYPTO_SAFETY_MARGIN=0.001
OPENMETEO_FORECAST_BASE_URL=https://api.open-meteo.com/v1
OPENMETEO_GEOCODING_BASE_URL=https://geocoding-api.open-meteo.com/v1
NOAA_BASE_URL=https://api.weather.gov
HTTP_TIMEOUT_SECONDS=12

INITIAL_BANKROLL_USD=10.00
PAPER_BANKROLL_USD=10.00
MAX_POSITION_PERCENT=10
MAX_POSITION_USD=1.00
MAX_TOTAL_EXPOSURE_PERCENT=25
MAX_DAILY_LOSS_PERCENT=10
MAX_DRAWDOWN_PERCENT=30
MIN_NET_EDGE=0.10
MIN_CONFIDENCE=55
MAX_SPREAD=0.08
SCAN_INTERVAL_MINUTES=20
USER_TIMEZONE=America/Argentina/Buenos_Aires
MODE=PAPER
VENUE=KALSHI
SAFETY_MARGIN=0.03
STALE_WEATHER_MINUTES=180
STALE_MARKET_MINUTES=20
ACTIONABLE_HORIZON_HOURS=24
PREFERRED_HORIZON_HOURS=24
MAX_MARKETS_PER_SCAN=250
